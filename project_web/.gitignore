# =============================================================================
# Vectoria Project - Master .gitignore
# =============================================================================

# --- 1. Environments & Sensitive Credentials ---
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
*.pem
*.key
*.pfx
*.p12
*.cert
*.crt
*credentials*.json
*service_account*.json
*service-account*.json
*client_secret*.json
token.json
tokens.json
secret*.json

# --- 2. Databases & Storage Dumps ---
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3
*.duckdb
*.parquet
*.dump
*.sql.gz
*.sql.tar
*.rdb

# --- 3. Python & Virtual Environments ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
**/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/

# Python test & lint caches
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
htmlcov/

# --- 4. Node, Vite & Frontend Builds ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/
**/.cache/
.vite/
**/.vite/
dist-ssr/
**/dist-ssr/
admin_v2/dist/
**/admin_v2/dist/

# --- 5. Operating System & Editor Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 6. Logs, Temporary & Scratch Files ---
*.log
**/*.log
*.tmp
**/*.tmp
*.bak
**/*.bak
scratch/
**/scratch/
tmp_*/
**/tmp_*/
temp_*/
**/temp_*/
test_*.html
preview_*.html
